        local door = currentRoom:FindFirstChild("Door")
        if door and door:FindFirstChild("Door") then
            local doorPart = door.Door
            doorPart.Open.SoundId = "rbxassetid://833871080"
            doorPart.Material = Enum.Material.Rock
            if doorPart:FindFirstChild("Sign") then
                doorPart.Sign.Material = Enum.Material.Rock
            end
        end
    end
end)

